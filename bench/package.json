{
  "name": "threejs-bench-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reproducible measurement harness and scorecard generator for threejs-bench scenes.",
  "bin": {
    "threejs-bench": "./run.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "run": "node run.mjs",
    "judge": "node judge.mjs",
    "scorecard": "node scorecard.mjs",
    "bench": "node run.mjs && node scorecard.mjs"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "puppeteer-core": "25.10.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
